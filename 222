#include "imgui.h"
#include "implot.h"
#include "implot_internal.h" // 包含内部头文件以使用某些高级功能
#include <vector>
#include <cmath>
#include <iostream>
#include <algorithm>

// 为了简化，我们在这里定义一些常量
constexpr int FREQ_BINS = 128; // 频率轴上的数据点数 (Y轴)
constexpr int TIME_SLICES = 256; // 时间轴上的数据点数 (X轴)

// 我们的频谱数据存储
// 使用静态变量，这样数据在每次UI渲染循环中都能保持
static std::vector<double> spectrogram_data;
static bool data_initialized = false;
static float animation_time = 0.0f;
static bool is_playing = true;
static float animation_speed = 1.0f;
static float time_axis_offset = 0.0f;        // 静态变量：时间轴偏移量，实现时间轴滚动
// 函数前向声明
void GenerateNewColumn(int time_slice);

// 初始化数据
void InitializeSpectrogramData() {
    if (data_initialized) {
        return;
    }
    
    std::cout << "Initializing spectrogram data..." << std::endl;
    spectrogram_data.resize(FREQ_BINS * TIME_SLICES, 0.0);

    #ifndef M_PI
    #define M_PI 3.14159265358979323846
    #endif

    // 生成初始数据
    for (int t = 0; t < TIME_SLICES; ++t) {
        GenerateNewColumn(t);
    }
    
    data_initialized = true;
    std::cout << "Data initialization complete." << std::endl;
}

// 生成新的一列数据
void GenerateNewColumn(int time_slice) {
    double time_norm = static_cast<double>(time_slice) / TIME_SLICES;
    
    for (int f = 0; f < FREQ_BINS; ++f) {
        double amplitude = 0.0;
        double freq_norm = static_cast<double>(f) / FREQ_BINS;
        
        // 使用动画时间来创建移动效果
        double animated_time = time_norm + animation_time * 0.1;
        
        // 1. Generate stable low frequency signal
        double freq1 = 0.1;
        amplitude += 0.5 * exp(-pow(freq_norm - freq1, 2) / 0.001);
        
        // 2. Generate time-varying signal
        double freq2 = 0.3 + 0.2 * sin(animated_time * 2 * M_PI);
        amplitude += 0.8 * exp(-pow(freq_norm - freq2, 2) / 0.002);
        
        // 3. Generate moving chirp signal
        double chirp_freq = 0.6 + 0.3 * sin(animated_time * M_PI);
        amplitude += 1.0 * exp(-pow(freq_norm - chirp_freq, 2) / 0.001);
        
        // 4. Add some noise
        amplitude += 0.1 * (rand() / (double)RAND_MAX);
        
        spectrogram_data[time_slice * FREQ_BINS + f] = amplitude;
    }
}

// 更新频谱数据以实现滚动效果
void UpdateSpectrogramData(float delta_time) {
    if (!is_playing) {
        return;
    }
    
    animation_time += delta_time * animation_speed;
    
    // 向左滚动数据（所有列向左移动一位）
    static float accumulator = 0.0f;
    accumulator += delta_time * animation_speed * 10.0f; // 滚动速度
    
    if (accumulator >= 1.0f) {
        accumulator -= 1.0f;
         // 更新时间轴偏移量，实现时间轴滚动
         time_axis_offset += 1.0f;
        // 将所有列向左移动
        for (int t = 0; t < TIME_SLICES - 1; ++t) {
            for (int f = 0; f < FREQ_BINS; ++f) {
                spectrogram_data[t * FREQ_BINS + f] = spectrogram_data[(t + 1) * FREQ_BINS + f];
            }
        }
        
        // 在最右边生成新的一列数据
        GenerateNewColumn(TIME_SLICES - 1);
    }
}

// 主渲染函数
void ShowSpectrogramWindow(bool* p_open) {
    // 初始化数据
    InitializeSpectrogramData();
    
    // 计算delta时间
    static float last_time = 0.0f;
    float current_time = ImGui::GetTime();
    float delta_time = current_time - last_time;
    last_time = current_time;
    
    // 更新数据
    UpdateSpectrogramData(delta_time);

    ImGui::SetNextWindowSize(ImVec2(600, 450), ImGuiCond_FirstUseEver);
    if (!ImGui::Begin("Spectrogram Demo", p_open)) {
        ImGui::End();
        return;
    }

    // --- 频谱图绘制 ---
    ImGui::Text("Real-time Scrolling Spectrogram");
    ImGui::Text("X-axis: Time, Y-axis: Frequency, Color: Signal Intensity");
    
    // 控制界面
    ImGui::Separator();
    if (ImGui::Button(is_playing ? "Pause" : "Play")) {
        is_playing = !is_playing;
    }
    ImGui::SameLine();
    ImGui::SliderFloat("Speed", &animation_speed, 0.1f, 5.0f, "%.1fx");
    
    // 显示数据统计
    if (!spectrogram_data.empty()) {
        double min_val = *std::min_element(spectrogram_data.begin(), spectrogram_data.end());
        double max_val = *std::max_element(spectrogram_data.begin(), spectrogram_data.end());
        ImGui::Text("Data range: %.3f to %.3f", min_val, max_val);
        ImGui::Text("Animation time: %.1f", animation_time);
    }

    // 设置颜色映射，Viridis 或 Plasma 对科学可视化效果很好
    ImPlot::PushColormap(ImPlotColormap_Viridis);

    // ImPlot::BeginPlot 是绘制区域的开始
    // ImPlotFlags_NoLegend 禁用了图例，因为热力图通常自带颜色条
    if (ImPlot::BeginPlot("##SpectrogramHeatmap", ImVec2(-1, -1), ImPlotFlags_NoLegend)) {
        
        // 设置坐标轴标签
        ImPlot::SetupAxes("Time", "Frequency");
        
        float time_min = time_axis_offset;
        float time_max = time_axis_offset + TIME_SLICES;
        // 设置坐标轴的范围以匹配我们的数据维度
        // X轴范围从 0 到 TIME_SLICES
        // Y轴范围从 0 到 FREQ_BINS
        ImPlot::SetupAxesLimits(0, TIME_SLICES, time_min, time_max, ImGuiCond_Always);

        // 核心绘图函数：PlotHeatmap
        // 注意：ImPlot::PlotHeatmap的坐标系可能需要调整
        ImPlot::PlotHeatmap(
            "Spectrogram",              // ID
            spectrogram_data.data(),    // 数据
            FREQ_BINS,                  // 行数 (Y轴)
            TIME_SLICES,                // 列数 (X轴)
            0.0,                        // 颜色刻度最小值
            2.0,                        // 颜色刻度最大值（调整为更合适的范围）
            NULL,                       // 标签格式
            ImPlotPoint(0, time_min),          // 起始点
            ImPlotPoint(TIME_SLICES, time_max)  // 结束点
        );

        // 绘制结束后必须调用 EndPlot
        ImPlot::EndPlot();
    }
    
    // 恢复默认的颜色映射
    ImPlot::PopColormap();

    ImGui::End();
}