
#include "imgui.h"              // 包含ImGui即时模式GUI库的主头文件
#include "implot.h"             // 包含ImPlot绘图扩展库的头文件
#include "implot_internal.h"    // 包含ImPlot内部头文件（包含某些高级功能，如热力图绘制）
#include <vector>               // 包含标准向量容器的头文件
#include <cmath>                // 包含数学函数库（如sin、cos、exp、pow等）
#include <iostream>             // 包含标准输入输出流库
#include <algorithm>            // 包含标准算法库（如std::min_element、std::max_element等）

// 为了简化，我们在这里定义一些常量
constexpr int ANGLE_BINS = 360;   // 角度轴上的数据点数（X轴）：360个角度点(0-359度)
constexpr int TIME_SLICES = 256; // 时间轴上的数据点数（Y轴）：256个时间片

// 我们的频谱数据存储
// 使用静态变量，这样数据在每次UI渲染循环中都能保持
static std::vector<double> spectrogram_data; // 静态变量：频谱图数据存储，二维数据展平为一维向量
static bool data_initialized = false;        // 静态变量：数据初始化标志，避免重复初始化
static float animation_time = 0.0f;          // 静态变量：动画时间，用于创建动态效果
static bool is_playing = true;               // 静态变量：播放状态，控制动画是否运行
static float animation_speed = 1.0f;         // 静态变量：动画速度，控制动画的快慢
static float time_axis_offset = 0.0f;        // 静态变量：时间轴偏移量，实现时间轴滚动

// 函数前向声明
void GenerateNewColumn(int time_slice); // 生成新列数据的函数声明，用于后续实现

// 初始化频谱图数据的方法 - 创建初始的频谱数据
void InitializeSpectrogramData() {
    if (data_initialized) { // 如果已经初始化过，直接返回，避免重复初始化
        return;
    }

    std::cout << "Initializing spectrogram data..." << std::endl; // 输出初始化开始信息到控制台
    spectrogram_data.resize(ANGLE_BINS * TIME_SLICES, 0.0); //调整数据容器大小：360*256=92160个点，初始值设为0

    // 定义PI常量（如果系统没有定义）
    #ifndef M_PI // 如果M_PI未定义
    #define M_PI 3.14159265358979323846 // 定义圆周率常量
    #endif

    // 生成初始数据 - 为每个时间片生成角度数据
    for (int t = 0; t < TIME_SLICES; ++t) { // 遍历所有时间片（0到255）
        GenerateNewColumn(t); // 为第t个时间片生成角度数据列
    }

    data_initialized = true; // 设置初始化完成标志为true
    std::cout << "Data initialization complete." << std::endl; // 输出初始化完成信息到控制台
}

void GenerateNewColumn(int time_slice) {
    double time_norm = static_cast<double>(time_slice) / TIME_SLICES; // 标准化时间值到0-1范围

    // 为每个角度点生成数据
    for (int a = 0; a < ANGLE_BINS; ++a) {
        double amplitude = 0.0;
        double angle_rad = static_cast<double>(a) * M_PI / 180.0;

        // 计算动画时间
        double animated_time = time_norm + animation_time * 0.1;

        // 生成主要的曲线信号 - 一条随时间变化的正弦曲线
        // 曲线中心角度随时间变化：从30度到330度
        double center_angle = 30.0 + 300.0 * animated_time;
        // 限制在0-360度范围内
        center_angle = fmod(center_angle, 360.0);
        double center_angle_rad = center_angle * M_PI / 180.0;

        // 计算当前角度到曲线中心的距离
        double angle_diff = angle_rad - center_angle_rad;
        // 处理角度环绕问题（比如359度和1度的差应该是2度，不是358度）
        if (angle_diff > M_PI) angle_diff -= 2 * M_PI;
        if (angle_diff < -M_PI) angle_diff += 2 * M_PI;

        // 生成高斯形状的信号峰
        double signal_width = 0.3; // 信号宽度（弧度）
        amplitude = 0.8 * exp(-pow(angle_diff, 2) / (2 * signal_width * signal_width));

        // 添加白噪声
        double noise = 0.1 * (2.0 * rand() / RAND_MAX - 1.0); // 生成-0.1到0.1的随机噪声
        amplitude += noise;

        // 确保幅度不为负
        if (amplitude < 0) amplitude = 0;

        // 存储数据
        spectrogram_data[time_slice * ANGLE_BINS + a] = amplitude;
    }
}

// 更新频谱数据以实现滚动效果的方法 - 使时间轴向上滚动显示
void UpdateSpectrogramData(float delta_time) {
    if (!is_playing) { // 如果未在播放状态，不更新数据
        return;
    }

    animation_time += delta_time * animation_speed; // 更新动画时间，根据动画速度调整

    // 向上滚动数据（所有行向上移动一位）
    static float accumulator = 0.0f; // 静态变量：滚动累加器，控制滚动频率
    accumulator += delta_time * animation_speed * 10.0f; // 增加滚动速度，乘以10使滚动更明显

    if (accumulator >= 1.0f) { // 当累加器达到阈值时执行滚动操作
        accumulator -= 1.0f; // 重置累加器，准备下一次滚动

        // 更新时间轴偏移量，实现时间轴滚动
        time_axis_offset += 1.0f;

        // 将所有行向上移动
        for (int t = 0; t < TIME_SLICES - 1; ++t) { // 遍历除最后一行外的所有时间片
            for (int a = 0; a < ANGLE_BINS; ++a) { // 遍历所有角度点
                // 将下一行的数据复制到当前行，实现向上滚动效果
                spectrogram_data[t * ANGLE_BINS + a] = spectrogram_data[(t + 1) * ANGLE_BINS + a];
            }
        }

        // 在最下面生成新的一行数据
        GenerateNewColumn(TIME_SLICES - 1); // 为最下面的时间片生成新的角度数据
    }
}

// 主渲染函数 - 显示频谱图窗口，这是主要的UI绘制函数
void ShowSpectrogramWindow(bool* p_open) {
    // 初始化数据
    InitializeSpectrogramData(); // 确保角度数据已初始化

    // 计算delta时间（帧间时间差）
    static float last_time = 0.0f; // 静态变量：上一帧的时间
    float current_time = ImGui::GetTime(); // 获取当前时间
    float delta_time = current_time - last_time; // 计算时间差，用于动画更新
    last_time = current_time; // 更新上一帧时间，为下一帧做准备

    // 更新数据
    UpdateSpectrogramData(delta_time); // 根据时间差更新角度数据

    // 设置窗口初始大小
    ImGui::SetNextWindowSize(ImVec2(600, 450), ImGuiCond_FirstUseEver); //设置窗口初始大小为600x450像素
    if (!ImGui::Begin("Spectrogram Demo", p_open)) { // 开始频谱图窗口，如果窗口未打开
        ImGui::End(); // 结束窗口绘制
        return; // 提前返回，不进行后续绘制
    }

    // --- 频谱图绘制 ---
    ImGui::Text("Real-time Scrolling Spectrogram"); // 显示标题文本：实时滚动频谱图
    ImGui::Text("X-axis: Angle (degrees), Y-axis: Time, Color: Signal Intensity"); //显示坐标轴说明文本

    // 控制界面
    ImGui::Separator(); // 绘制分隔线
    // 播放/暂停按钮
    if (ImGui::Button(is_playing ? "Pause" : "Play")) { // 绘制播放/暂停按钮，根据状态显示不同文本
        is_playing = !is_playing; // 点击时切换播放状态
    }
    ImGui::SameLine(); // 将下一个控件放在同一行
    // 速度控制滑块
    ImGui::SliderFloat("Speed", &animation_speed, 0.1f, 5.0f, "%.1fx"); //绘制速度控制滑块，范围0.1x到5.0x

    // 显示数据统计信息
    if (!spectrogram_data.empty()) { // 如果角度数据非空
        // 计算数据的最小值和最大值
        double min_val = *std::min_element(spectrogram_data.begin(), spectrogram_data.end()); //找到数据中的最小值
        double max_val = *std::max_element(spectrogram_data.begin(), spectrogram_data.end()); //找到数据中的最大值
        ImGui::Text("Data range: %.3f to %.3f", min_val, max_val); // 显示数据范围信息
        ImGui::Text("Animation time: %.1f", animation_time); // 显示当前动画时间
    }

    // 设置颜色映射，Viridis对科学可视化效果很好
    ImPlot::PushColormap(ImPlotColormap_Viridis); // 推入Viridis颜色映射，适合科学数据可视化

    // ImPlot::BeginPlot是绘制区域的开始
    // ImPlotFlags_NoLegend禁用了图例，因为热力图通常自带颜色条
    if (ImPlot::BeginPlot("##SpectrogramHeatmap", ImVec2(-1, -1), ImPlotFlags_NoLegend)) { //开始ImPlot绘图，禁用图例

          // 设置坐标轴标签
          ImPlot::SetupAxes("Angle (degrees)", "Time"); // 设置X轴标签为"Angle
          // 设置坐标轴的范围以匹配我们的数据维度
          // X轴范围从0到360 (角度)
          // Y轴范围动态设置，实现时间轴滚动
          float time_min = time_axis_offset;
          float time_max = time_axis_offset + TIME_SLICES;

            // 使用ImPlotCond_Always强制每帧更新坐标轴范围
            ImPlot::SetupAxisLimits(ImAxis_X1, 0, 360, ImPlotCond_Always); // X轴：0-360度，每帧强制更新       
            ImPlot::SetupAxisLimits(ImAxis_Y1, time_min, time_max, ImPlotCond_Always); //Y轴：动态时间范围，每帧强制更新

        // 核心绘图函数：PlotHeatmap - 绘制热力图
        ImPlot::PlotHeatmap(
            "Spectrogram",              // 图例ID：频谱图
            spectrogram_data.data(),    // 数据指针：指向角度数据的首地址
            ANGLE_BINS,                 // 行数（X轴）：360行，对应角度
            TIME_SLICES,                // 列数（Y轴）：256列，对应时间
            0.0,                        // 颜色刻度最小值：0.0
            2.0,                        // 颜色刻度最大值：2.0（调整为更合适的范围）
            NULL,                     // 标签格式
            ImPlotPoint(0, time_min),   // 边界最小点：(0度, 当前时间最小值)
            ImPlotPoint(360, time_max)  // 边界最大点：(360度, 当前时间最大值)
        );

        // 绘制结束后必须调用EndPlot
        ImPlot::EndPlot(); // 结束ImPlot绘图
    }

    // 恢复默认的颜色映射
    ImPlot::PopColormap(); // 弹出颜色映射，恢复默认设置

    ImGui::End(); // 结束窗口绘制
}